# Copy to .env.local for local dev. Never commit the filled-in version.
# See backend/docs/trd.md "Environment configuration" for the full contract.

NODE_ENV=development
PORT=3000

# Neon Postgres connection string. During Phase 0-4 of backend/docs/migration-plan.md
# this can point at the SAME database the rest of the repo already uses (copy the
# value from the repo root .env's DATABASE_URL) — this service only READS/WRITES
# through its own auth/authorization layer, it does not change what data exists.
# It gets its own rotated credential only at Phase 5.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# JWT signing secrets for THIS service's own access/refresh tokens (not Firebase's).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Firebase Admin SDK — used to verify the ID tokens both members (phone auth)
# and staff (email/password, once bootstrapped — see backend/docs/security.md)
# already obtain from Firebase client SDKs. Paste the full service-account JSON
# as a single line here, or point FIREBASE_ADMIN_CREDENTIALS_FILE at a
# git-ignored file path instead.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS=
FIREBASE_ADMIN_CREDENTIALS_FILE=
