# Copy to .env.local for local dev. Never commit the filled-in version.
# See backend/docs/trd.md "Environment configuration" for the full contract.

NODE_ENV=development
PORT=3000

# Neon Postgres connection string. During Phase 0-4 of backend/docs/migration-plan.md
# this can point at the SAME database the rest of the repo already uses (copy the
# value from the repo root .env's DATABASE_URL) — this service only READS/WRITES
# through its own auth/authorization layer, it does not change what data exists.
# It gets its own rotated credential only at Phase 5.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# JWT signing secrets for THIS service's own access/refresh tokens (not Firebase's).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Firebase Admin SDK — used to verify the ID tokens both members (phone auth)
# and staff (email/password, once bootstrapped — see backend/docs/security.md)
# already obtain from Firebase client SDKs. Paste the full service-account JSON
# as a single line here, or point FIREBASE_ADMIN_CREDENTIALS_FILE at a
# git-ignored file path instead.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_CREDENTIALS=
FIREBASE_ADMIN_CREDENTIALS_FILE=

# Supabase Storage — customer review videos uploaded from the admin console's
# "Customer Videos" page. Leave these empty and the console shows "Video
# storage isn't set up yet" instead of an upload. Setup steps (bucket, key):
# docs/admin-console.md → "Customer videos (Supabase Storage)".
#
# Project URL, from Supabase → Project Settings → API.
SUPABASE_URL=
# The project's service_role key (or a secret key). SERVER ONLY — it bypasses
# row-level security. Never put it in the console, the app, or git.
SUPABASE_SERVICE_ROLE_KEY=
# A PUBLIC bucket used for nothing but these videos.
SUPABASE_PUBLIC_BUCKET=customer-reviews
# Largest video the console may upload, in MB. Supabase's free plan caps every
# file at 50 MB; raise this together with the bucket's own limit on a paid plan.
REVIEW_VIDEO_MAX_MB=50
