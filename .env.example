# Neon Postgres — copy this file to `.env` (git-ignored) and paste the real
# value from the Neon console → your project → "Connection string".
#
# It already looks like the line below. Keep `?sslmode=require`. Extra params
# Neon adds (e.g. `&channel_binding=require`) are fine to leave in.
#
# Run the app against it with:
#   flutter run --dart-define-from-file=.env
#
# Verify the connection on its own with:
#   dart run tool/neon_ping.dart
#
DATABASE_URL=postgresql://USER:PASSWORD@ep-billowing-star-aozk27aq.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Sentry — crash and error reporting (lib/main.dart). Leave blank and it
# simply stays disabled, same as an unset DATABASE_URL leaves the catalogue
# empty rather than erroring. From a Sentry project → Settings → Client
# Keys (DSN); create a Flutter project first if there isn't one yet. Unlike
# DATABASE_URL this has no '&', so plain --dart-define-from-file=.env works
# on Windows. See docs/sentry.md.
SENTRY_DSN=
